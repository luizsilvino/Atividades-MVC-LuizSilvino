@model IEnumerable<AlunosMVC.Models.Aluno>
<h1>Alunos</h1>
<table class="table">
<tr><th>ID</th><th>Nome</th><th>Idade</th><th>Curso</th><th></th></tr>
@foreach (var aluno in Model)
{
<tr><td>@aluno.Id</td><td>@aluno.Nome</td><td>@aluno.Idade</td><td>@aluno.Curso</td><td><a asp-action="Detalhes" asp-route-id="@aluno.Id">Detalhes</a></td></tr>
}
</table>
